<UserControl
    x:Class="DashDock.Views.ImageGalleryArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:DashDock.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ImageGalleryAreaViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeAsyncCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Border
        Background="#1d1f23"
        BorderBrush="#1d1f23"
        BorderThickness="5"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Height="10"
                Margin="15,0"
                Background="#1d1f23">
                <ProgressBar
                    Height="3"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="LightSkyBlue"
                    Maximum="{Binding RefreshMaxSeconds}"
                    Minimum="0"
                    Style="{x:Null}"
                    Value="{Binding RefreshProgress}">
                    <b:Interaction.Behaviors>
                        <behaviors:SmoothProgressBehavior AnimationDuration="0:0:0.2" TargetValue="{Binding RefreshProgress}" />
                    </b:Interaction.Behaviors>
                </ProgressBar>

            </Border>

            <Border
                Grid.Row="1"
                ClipToBounds="True"
                CornerRadius="16">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill" />
                </Border.Background>

                <!-- サイズ確保用のダミーImage（透明） -->
                <Image
                    Opacity="0"
                    Source="{Binding ImagePath}"
                    Stretch="Uniform" />
            </Border>
        </Grid>
    </Border>

</UserControl>