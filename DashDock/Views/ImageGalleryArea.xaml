<UserControl
    x:Class="DashDock.Views.ImageGalleryArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashDock.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ImageGalleryAreaViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Border
        Background="#1d1f23"
        BorderBrush="#1d1f23"
        BorderThickness="5"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Height="10"
                Background="#1d1f23" />

            <TextBlock
                Grid.Row="1"
                Foreground="White"
                Text="Image GalleryArea" />
        </Grid>
    </Border>

</UserControl>