<UserControl
    x:Class="DashDock.Views.PointArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:PointAreaViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LightFgBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{StaticResource MediumBgBrush}"
        CornerRadius="6">
        <StackPanel>
            <TextBlock Text="{Binding Header}" />
            <StackPanel Margin="15,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0"
                        FontSize="24"
                        FontWeight="Regular"
                        Text="{Binding Points, StringFormat={}{0:D} Pts}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>