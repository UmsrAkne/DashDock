<UserControl
    x:Class="DashDock.Views.PointArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:PointAreaViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeAsyncCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LightFgBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{StaticResource MediumBgBrush}"
        CornerRadius="6">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="15,0"
                    FontSize="24"
                    FontWeight="Regular"
                    Text="{Binding Points, StringFormat={}{0:D} Pts}" />

                <Button
                    Margin="20,0"
                    Padding="10,3"
                    BorderThickness="0"
                    Command="{Binding UpdatePointAsyncCommand}">
                    <Button.Resources>
                        <Style TargetType="Frame">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </Button.Resources>
                    <Button.Content>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Update" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>