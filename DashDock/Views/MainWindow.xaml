<mah:MetroWindow
    x:Class="DashDock.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    xmlns:views="clr-namespace:DashDock.Views"
    Title="{Binding Title}"
    Width="1024"
    Height="480"
    d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
    GlowBrush="{DynamicResource PrimaryHueMidBrush}"
    NonActiveWindowTitleBrush="{DynamicResource MaterialDesignPaper}"
    TitleCharacterCasing="Normal"
    WindowTitleBrush="{DynamicResource PrimaryHueMidBrush}"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:PointAreaViewModel}">
            <views:PointArea />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:TimeTrackingAreaViewModel}">
            <views:TimeTrackingArea />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:NoteAreaViewModel}">
            <views:NoteArea />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingAreaViewModel}">
            <views:SettingArea />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <ItemsControl ItemsSource="{Binding ToolAreaViewModels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="DockPanel.Dock" Value="Top" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Margin="6,4" Content="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            x:Name="SettingsButton"
            Width="36"
            Height="36"
            Margin="0,8,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding OpenSettingsCommand}"
            Foreground="{StaticResource LightFgBrush}"
            Style="{StaticResource MaterialDesignIconButton}">

            <materialDesign:PackIcon
                Width="25"
                Height="25"
                Kind="Cog" />
        </Button>

        <Popup
            AllowsTransparency="True"
            HorizontalOffset="36"
            IsOpen="{Binding IsSettingsOpen}"
            Placement="Left"
            PlacementTarget="{Binding ElementName=SettingsButton}"
            StaysOpen="False"
            VerticalOffset="41">
            <Border
                Padding="12"
                Background="{StaticResource DarkBgBrush}"
                BorderBrush="{StaticResource MaterialDesignDarkSeparatorBackground}"
                BorderThickness="1"
                CornerRadius="4">
                <ContentControl Content="{Binding SettingAreaViewModel}" />
            </Border>
        </Popup>
    </Grid>
</mah:MetroWindow>