<UserControl
    x:Class="DashDock.Views.TimeTrackingArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DashDock.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:TimeTrackingAreaViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeAsyncCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding Header}" />
            <TextBlock Text="{Binding CurrentEntry.StartTime}" />
        </StackPanel>
    </Grid>
</UserControl>