<prism:PrismApplication
    x:Class="DashDock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <system:Double x:Key="GlobalFontSize">15</system:Double>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#333355" />
        <SolidColorBrush x:Key="MediumBgBrush" Color="#444488" />
        <SolidColorBrush x:Key="LightBgBrush" Color="SteelBlue" />
        <SolidColorBrush x:Key="LightFgBrush" Color="WhiteSmoke" />
    </Application.Resources>
</prism:PrismApplication>